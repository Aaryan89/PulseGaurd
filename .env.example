# ==========================================
# PulseGuard Risk Console Environment Config
# ==========================================

# Port mapping for Docker Compose
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------
# Cost Model Defaults
# ------------------------------------------
# Cost of a false negative (missed fraud) as a multiplier of transaction amount. 
# 1.15 = 100% loss of goods + 15% chargeback fee
COST_FN_MULTIPLIER=1.15

# Cost of a false positive (blocked good transaction) as a multiplier of transaction amount.
# 0.02 = 2% lost profit margin
COST_FP_MULTIPLIER=0.02

# Fixed operational cost for a manual review in the tiered policy
COST_PER_REVIEW=50.0

# ------------------------------------------
# Auto-Responder Webhooks
# ------------------------------------------
# Toggle to enable/disable webhook firing
WEBHOOK_ENABLED=true

# The URL to send the webhook payload to
WEBHOOK_URL=http://localhost:8000/internal/webhook-stub
